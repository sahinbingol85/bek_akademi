---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';

// Astro.glob yerine garantili import.meta.glob kullanıyoruz
const rawPosts = import.meta.glob('./*.md', { eager: true });
const posts = Object.values(rawPosts);
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<Layout description="LGS, YKS, eğitim koçluğu ve yeni nesil eğitim üzerine uzman makaleleri ve rehber yazılarımız." title="Eğitim Rehberi | BEK Eğitim Akademi">
    <section class="py-24 bg-[#F8F9FA] min-h-screen relative overflow-hidden">
        <!-- Arka Plan Dekoratif Elementleri -->
        <div class="absolute top-0 left-0 w-full h-96 bg-bek-dark rounded-b-[100px] md:rounded-b-[200px] z-0"></div>
        <div class="absolute top-20 right-10 w-64 h-64 bg-bek-gold opacity-10 blur-3xl rounded-full z-0"></div>

        <div class="container mx-auto px-6 max-w-7xl relative z-10">
            
            <!-- Başlık Alanı (Dark Tema Üzerine Beyaz/Gold) -->
            <div class="text-center max-w-3xl mx-auto mb-20 pt-10">
                <span class="text-bek-gold font-bold tracking-widest uppercase text-sm mb-4 block">BEK Akademi Blog</span>
                <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight">
                    Eğitim <span class="font-light">Rehberi</span>
                </h1>
                <p class="text-lg text-gray-300 font-light leading-relaxed">
                    Sınav sürecinde yanınızdayız. Uzman eğitim kadromuzun kaleminden LGS, YKS ve yeni nesil rehberlik makaleleri.
                </p>
            </div>

            <!-- VIP Blog Kartları Izgarası (3 Kolonlu) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                {sortedPosts.map((post: any) => (
                    <article class="bg-white rounded-[2rem] overflow-hidden shadow-lg shadow-gray-200/50 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 border border-gray-100 flex flex-col group">
                        
                        <!-- Kart Üst Görsel/Gradient Alanı -->
                        <div class="h-48 bg-gradient-to-br from-bek-dark to-gray-800 relative overflow-hidden">
                            <div class="absolute inset-0 bg-bek-gold/20 group-hover:bg-bek-gold/40 transition-colors duration-500"></div>
                            <!-- Kategori Etiketi -->
                            <div class="absolute bottom-5 left-6">
                                <span class="bg-white/95 backdrop-blur-sm text-bek-dark text-xs font-extrabold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-sm">
                                    {post.frontmatter.category || 'Rehberlik'}
                                </span>
                            </div>
                        </div>

                        <!-- Kart İçeriği -->
                        <div class="p-8 flex-1 flex flex-col">
                            <time class="text-bek-gold text-sm font-semibold mb-3 tracking-wider">{post.frontmatter.date}</time>
                            
                            <h2 class="text-2xl font-bold text-bek-dark mb-4 group-hover:text-bek-gold transition-colors duration-300 leading-tight">
                                <a href={post.url} class="focus:outline-none">
                                    <span class="absolute inset-0" aria-hidden="true"></span>
                                    {post.frontmatter.title}
                                </a>
                            </h2>
                            
                            <p class="text-gray-500 leading-relaxed mb-8 flex-1 line-clamp-3 font-light text-sm">
                                {post.frontmatter.description}
                            </p>
                            
                            <!-- Kart Alt Kısmı (Yazar ve Buton) -->
                            <div class="mt-auto flex items-center justify-between border-t border-gray-100 pt-6">
                                <span class="text-xs font-medium text-gray-400 uppercase tracking-wide">
                                    {post.frontmatter.author || 'BEK Akademi'}
                                </span>
                                <span class="inline-flex items-center text-sm font-bold text-bek-dark group-hover:text-bek-gold transition-colors">
                                    Oku 
                                    <svg class="w-5 h-5 ml-2 group-hover:translate-x-2 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                                </span>
                            </div>
                        </div>
                    </article>
                ))}
            </div>

        </div>
    </section>
</Layout>