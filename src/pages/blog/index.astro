---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';

// Astro.glob yerine garantili import.meta.glob kullanıyoruz
const rawPosts = import.meta.glob('./*.md', { eager: true });
const posts = Object.values(rawPosts);
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<Layout title="Eğitim Rehberi | BEK Eğitim Akademi" description="LGS, YKS, eğitim koçluğu ve yeni nesil eğitim üzerine uzman makaleleri ve rehber yazılarımız.">
    <section class="py-24 bg-bek-bg min-h-screen">
        <div class="container mx-auto px-6 max-w-5xl">
            
            <div class="text-center mb-16">
                <h1 class="text-4xl md:text-5xl font-light text-bek-dark mb-4 tracking-tight">
                    Eğitim <span class="font-bold text-bek-gold">Rehberi</span>
                </h1>
                <p class="text-lg text-gray-500 font-light">Uzman kadromuzun kaleminden başarıya giden yol haritaları.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {sortedPosts.map((post: any) => (
                    <a href={post.url} class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100 group">
                        <p class="text-bek-gold text-sm font-semibold mb-3">{post.frontmatter.date}</p>
                        <h2 class="text-2xl font-bold text-bek-dark mb-3 group-hover:text-bek-gold transition-colors">{post.frontmatter.title}</h2>
                        <p class="text-gray-500 leading-relaxed line-clamp-3">{post.frontmatter.description}</p>
                        <span class="inline-flex items-center mt-6 text-sm font-bold text-bek-dark group-hover:text-bek-gold transition-colors">
                            Yazıyı Oku 
                            <svg class="w-4 h-4 ml-2 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </span>
                    </a>
                ))}
            </div>

        </div>
    </section>
</Layout>