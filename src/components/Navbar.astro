---
// Navbar.astro
---
<header class="bg-white border-b-2 border-bek-gold shadow-sm sticky top-0 z-50">
    <nav class="container mx-auto px-6 py-4 flex items-center justify-between">
        
        <!-- Logo / İsim (Z-index ile menünün üstünde kalmasını sağladık) -->
        <a href="#hero" class="flex items-center gap-3 relative z-20">
            <img src="/images/logo.png" alt="BEK Logo" class="h-12 w-auto object-contain">
            <span class="text-3xl font-bold text-bek-dark tracking-tight">
                <span class="text-bek-gold">BEK</span> Akademi
            </span>
        </a>
        
        <!-- MASAÜSTÜ MENÜ (Mobilde Gizli) -->
        <div class="hidden md:flex items-center space-x-6 font-medium">
            <a href="#hakkimizda" class="text-bek-dark hover:text-bek-gold transition">Felsefemiz</a>
            <a href="#programlar" class="text-bek-dark hover:text-bek-gold transition">Programlar</a>
            <a href="#iletisim" class="text-bek-dark hover:text-bek-gold transition pr-4 border-r border-gray-200">İletişim</a>
            
            <a href="#" class="flex items-center gap-2 bg-bek-dark text-white px-6 py-2.5 rounded-full hover:bg-black transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 group">
                <svg class="w-5 h-5 text-bek-gold group-hover:animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                Veli Sistemi
            </a>
        </div>

        <!-- MOBİL MENÜ BUTONU (Hamburger İkonu) -->
        <button id="mobile-menu-btn" class="md:hidden flex items-center p-2 text-bek-dark focus:outline-none relative z-20" aria-label="Menüyü Aç">
            <svg id="menu-icon" class="w-8 h-8 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path id="menu-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
        
    </nav>

    <!-- MOBİL MENÜ İÇERİĞİ (Tam Ekran Açılır Kapanır) -->
    <div id="mobile-menu" class="fixed inset-0 bg-white/95 backdrop-blur-sm z-10 flex flex-col items-center justify-center space-y-8 opacity-0 pointer-events-none transition-all duration-300 md:hidden">
        <a href="#hakkimizda" class="mobile-link text-2xl font-medium text-bek-dark hover:text-bek-gold transition">Felsefemiz</a>
        <a href="#programlar" class="mobile-link text-2xl font-medium text-bek-dark hover:text-bek-gold transition">Programlar</a>
        <a href="#iletisim" class="mobile-link text-2xl font-medium text-bek-dark hover:text-bek-gold transition">İletişim</a>
        
        <a href="#" class="mobile-link mt-4 flex items-center gap-2 bg-bek-dark text-white px-8 py-4 rounded-full hover:bg-black transition-all duration-300 shadow-md">
            <svg class="w-6 h-6 text-bek-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
            Veli Sistemi
        </a>
    </div>
</header>

<script>
    // Mobil Menü JavaScript Kodları
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconPath = document.getElementById('menu-path');
    const links = document.querySelectorAll('.mobile-link');
    let isOpen = false;

    function toggleMenu() {
        isOpen = !isOpen;
        if (isOpen) {
            // Menüyü Aç
            menu.classList.remove('opacity-0', 'pointer-events-none');
            menu.classList.add('opacity-100', 'pointer-events-auto');
            // Hamburger ikonunu çarpıya (X) çevir
            iconPath.setAttribute('d', 'M6 18L18 6M6 6l12 12');
            // Menü açıkken arka planın (sitenin) kaymasını engelle
            document.body.style.overflow = 'hidden';
        } else {
            // Menüyü Kapat
            menu.classList.remove('opacity-100', 'pointer-events-auto');
            menu.classList.add('opacity-0', 'pointer-events-none');
            // İkonu tekrar üç çizgiye çevir
            iconPath.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
            // Arka plan kaymasını geri aç
            document.body.style.overflow = 'auto';
        }
    }

    // Butona tıklama olayı
    btn.addEventListener('click', toggleMenu);

    // Linklere (Felsefemiz, İletişim vs.) tıklandığında menüyü otomatik kapat
    links.forEach(link => {
        link.addEventListener('click', toggleMenu);
    });
</script>