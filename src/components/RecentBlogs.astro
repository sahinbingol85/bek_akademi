---
// src/components/RecentBlogs.astro

// Blog klasöründeki md dosyalarını okur
const rawPosts = import.meta.glob('../pages/blog/*.md', { eager: true });
const posts = Object.values(rawPosts);

// En yeni 3 yazıyı tarihe göre sıralar
const sortedPosts = posts
    .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf())
    .slice(0, 3);
---

<section id="egitim-rehberi" class="py-24 bg-white relative overflow-hidden">
    <!-- Dekoratif Arka Plan -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-bek-gold/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 z-0 pointer-events-none"></div>

    <div class="container mx-auto px-6 max-w-7xl relative z-10">
        
        <!-- Başlık -->
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="text-bek-gold font-bold tracking-widest uppercase text-xs mb-3 block">Uzman Kaleminden</span>
            <h2 class="text-4xl md:text-5xl font-extrabold text-bek-dark mb-4 tracking-tight">
                Eğitim <span class="font-light">Rehberi</span>
            </h2>
            <p class="text-gray-500 font-light text-lg">
                VIP eğitim modelimiz, sınav stratejileri ve veli rehberliği hakkında güncel makaleler.
            </p>
        </div>

        <!-- 3'lü Blog Vitrini (Grid) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {sortedPosts.map((post: any) => (
                <!-- Kartın tamamını link (a) etiketi yaptık ve 'relative' ekleyerek taşmayı önledik -->
                <a href={post.url} class="bg-[#F8F9FA] rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100 flex flex-col group relative">
                    <div class="p-8 flex-1 flex flex-col">
                        <!-- Kategori ve Tarih -->
                        <div class="flex items-center justify-between mb-4">
                            <!-- Kategori rengi BEK Gold tonuna uyarlandı -->
                            <span class="bg-bek-gold/10 text-bek-gold text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                                {post.frontmatter.category || 'Rehberlik'}
                            </span>
                            <time class="text-gray-400 text-xs font-medium tracking-wider">
                                {new Date(post.frontmatter.date).toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
                            </time>
                        </div>
                        
                        <!-- Başlık -->
                        <h3 class="text-xl font-bold text-bek-dark mb-3 group-hover:text-bek-gold transition-colors duration-300 leading-tight">
                            {post.frontmatter.title}
                        </h3>
                        
                        <!-- Özet -->
                        <p class="text-gray-500 leading-relaxed flex-1 line-clamp-3 font-light text-sm mb-6">
                            {post.frontmatter.description}
                        </p>
                        
                        <!-- Okuma Butonu -->
                        <div class="mt-auto border-t border-gray-200 pt-4 flex items-center justify-between">
                            <span class="text-[10px] font-medium text-gray-400 uppercase tracking-wide">
                                {post.frontmatter.author || 'BEK Akademi'}
                            </span>
                            <span class="inline-flex items-center text-xs font-bold text-bek-dark group-hover:text-bek-gold transition-colors">
                                Yazıyı Oku 
                                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                            </span>
                        </div>
                    </div>
                </a>
            ))}
        </div>
        
    </div>
</section>
