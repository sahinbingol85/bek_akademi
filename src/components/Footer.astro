---
// Footer.astro
---
<footer class="bg-bek-dark text-gray-300 py-12 border-t-4 border-bek-gold">
    <div class="container mx-auto px-6">
        
        <!-- Üst Kısım: Tamamen Ortalanmış Logo ve Yazılar -->
        <div class="flex flex-col items-center justify-center mb-12 text-center">
            
            <!-- Logo / İsim -->
            <a href="#hero" class="flex flex-col items-center gap-4 hover:opacity-80 transition-opacity">
                <!-- Footer Logosu -->
                <img src="/images/logo.png" alt="BEK Logo" class="h-20 w-auto bg-white p-3 rounded-2xl shadow-md">
                
                <div class="mt-2">
                    <span class="block text-3xl font-bold text-white tracking-tight">
                        <span class="text-bek-gold">BEK</span> Akademi
                    </span>
                    <span class="block text-base text-gray-400 font-light mt-2">Yeni Nesil Eğitim & VIP Koçluk</span>
                </div>
            </a>
            
            <!-- Sosyal Medya İkonu (Logonun hemen altında, ortalı) -->
            <div class="flex space-x-4 mt-8">
                <a href="https://www.instagram.com/bekegitimakademi" target="_blank" aria-label="Instagram" class="w-12 h-12 bg-gray-800 rounded-full flex items-center justify-center hover:bg-bek-gold hover:text-white transition-all duration-300 shadow-sm">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </a>
            </div>
        </div>
        
        <!-- Orta Kısım: Yasal Linkler -->
        <div class="border-t border-gray-700 pt-8 pb-6 flex flex-wrap justify-center gap-4 md:gap-8 text-sm text-gray-400 font-light">
            <a href="/kvkk" class="hover:text-bek-gold transition-colors">KVKK Aydınlatma Metni</a>
            <span class="hidden md:inline text-gray-600">|</span>
            <a href="/gizlilik" class="hover:text-bek-gold transition-colors">Gizlilik Politikası</a>
            <span class="hidden md:inline text-gray-600">|</span>
            <a href="/cerez" class="hover:text-bek-gold transition-colors">Çerez Politikası</a>
            <span class="hidden md:inline text-gray-600">|</span>
            <a href="/kullanim" class="hover:text-bek-gold transition-colors">Kullanım Koşulları</a>
        </div>

        <!-- Alt Kısım: Telif ve Geliştirici İmzası -->
        <div class="border-t border-gray-800 pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500">
            <p>© {new Date().getFullYear()} BEK Eğitim Akademi. Tüm Hakları Saklıdır.</p>
            
            <p class="flex items-center gap-1">
                Designed & Developed by 
                <a href="https://ansdatatech.com" target="_blank" class="font-bold text-gray-300 hover:text-bek-gold transition-colors tracking-wide">
                    ANS DataTech
                </a>
            </p>
        </div>
        
    </div>
</footer>