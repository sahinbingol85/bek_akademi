---
// src/layouts/BlogLayout.astro
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | BEK Akademi Eğitim Rehberi`} description={frontmatter.description}>
    <main class="bg-[#F8F9FA] min-h-screen pb-24">
        
        <!-- Üst Kısım (Hero) - Karanlık VIP Tema -->
        <section class="bg-bek-dark pt-32 pb-28 relative overflow-hidden rounded-b-[3rem] md:rounded-b-[5rem] z-0">
            <div class="absolute inset-0 bg-bek-gold/5"></div>
            <div class="absolute top-0 right-0 w-64 h-64 bg-bek-gold opacity-10 blur-3xl rounded-full"></div>
            
            <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
                <!-- Geri Dön Butonu -->
                <a href="/blog" class="inline-flex items-center text-bek-gold hover:text-white transition-colors mb-8 font-semibold tracking-widest uppercase text-sm">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Rehbere Dön
                </a>
                
                <!-- Yazı Başlığı -->
                <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-6 leading-tight tracking-tight">
                    {frontmatter.title}
                </h1>
                
                <!-- Yazar ve Tarih Bilgisi -->
                <div class="flex items-center justify-center text-gray-400 text-sm font-light space-x-3">
                    <span class="flex items-center font-medium text-gray-300">
                        <svg class="w-4 h-4 mr-1 text-bek-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        {frontmatter.author || 'BEK Akademi'}
                    </span>
                    <span class="text-gray-600">•</span>
                    <span class="flex items-center">
                        <svg class="w-4 h-4 mr-1 text-bek-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        {frontmatter.date}
                    </span>
                </div>
            </div>
        </section>

        <!-- Okuma Alanı (Aydınlık İçerik Kartı) -->
        <article class="container mx-auto px-6 max-w-3xl -mt-16 relative z-20">
            <div class="bg-white rounded-3xl shadow-xl shadow-gray-200/50 p-8 md:p-14 border border-gray-100">
                
                <!-- Markdown'un Styllendiği Yer (Tailwind Typography) -->
                <div class="prose prose-lg md:prose-xl max-w-none 
                            prose-headings:text-bek-dark prose-headings:font-bold prose-headings:tracking-tight
                            prose-a:text-bek-gold hover:prose-a:text-bek-dark prose-a:no-underline prose-a:font-semibold transition-colors
                            prose-p:text-gray-600 prose-p:leading-relaxed prose-p:font-light
                            prose-blockquote:border-l-4 prose-blockquote:border-bek-gold prose-blockquote:bg-gray-50 prose-blockquote:p-6 prose-blockquote:italic prose-blockquote:text-gray-700 prose-blockquote:rounded-r-xl
                            prose-li:text-gray-600 prose-li:font-light marker:text-bek-gold
                            prose-strong:text-bek-dark prose-strong:font-semibold">
                    <slot />
                </div>
                
                <!-- Otomatik Pazarlama/Satış Modülü -->
                <div class="mt-16 pt-10 border-t border-gray-100 text-center bg-gray-50 -mx-8 md:-mx-14 -mb-8 md:-mb-14 p-8 md:p-14 rounded-b-3xl">
                    <h3 class="text-2xl font-bold text-bek-dark mb-4 tracking-tight">Eğitim Yolculuğunuzda Yanınızdayız</h3>
                    <p class="text-gray-500 mb-8 font-light max-w-lg mx-auto leading-relaxed">Öğrencinize özel hazırlanan veri destekli VIP koçluk sistemimizle tanışmak ve başarıyı şansa bırakmamak için kahvemizi içmeye bekleriz.</p>
                    <a href="/#iletisim" class="inline-flex items-center bg-bek-gold text-white px-8 py-4 rounded-full hover:bg-bek-dark hover:scale-105 transition-all duration-300 shadow-md shadow-bek-gold/20 font-medium">
                        Bize Ulaşın
                        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                </div>

            </div>
        </article>
    </main>
</Layout>