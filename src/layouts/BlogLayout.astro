---
// src/layouts/BlogLayout.astro
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | BEK Akademi Eğitim Rehberi`} description={frontmatter.description}>
    <main class="bg-[#F8F9FA] min-h-screen pb-20">
        
        <!-- Üst Kısım (Hero) - Daraltıldı -->
        <section class="bg-bek-dark pt-24 pb-20 relative overflow-hidden rounded-b-[2rem] md:rounded-b-[4rem] z-0 shadow-inner">
            <div class="absolute inset-0 bg-bek-gold/5"></div>
            <div class="absolute top-0 right-0 w-48 h-48 bg-bek-gold opacity-15 blur-2xl rounded-full"></div>
            
            <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
                <!-- Geri Dön Butonu -->
                <a href="/blog" class="inline-flex items-center text-bek-gold hover:text-white transition-colors mb-6 font-semibold tracking-widest uppercase text-xs">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Rehbere Dön
                </a>
                
                <!-- Yazı Başlığı -->
                <h1 class="text-2xl md:text-4xl font-extrabold text-white mb-4 leading-tight tracking-tight">
                    {frontmatter.title}
                </h1>
                
                <!-- Yazar ve Tarih Bilgisi -->
                <div class="flex items-center justify-center text-gray-400 text-xs font-light space-x-3">
                    <span class="flex items-center font-medium text-gray-300">
                        <svg class="w-3 h-3 mr-1 text-bek-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        {frontmatter.author || 'BEK Akademi'}
                    </span>
                    <span class="text-gray-600">•</span>
                    <span class="flex items-center">
                        <svg class="w-3 h-3 mr-1 text-bek-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        {frontmatter.date}
                    </span>
                </div>
            </div>
        </section>

        <!-- Okuma Alanı (Aydınlık İçerik Kartı) -->
        <article class="container mx-auto px-6 max-w-3xl -mt-12 relative z-20">
            <div class="bg-white rounded-2xl shadow-lg shadow-gray-200/40 p-6 md:p-10 border border-gray-100">
                
                <!-- Markdown'un Styllendiği Yer (Tailwind Typography) -->
                <div class="prose prose-base md:prose-lg max-w-none 
                            prose-headings:text-bek-dark prose-headings:font-bold prose-headings:tracking-tight
                            prose-a:text-bek-gold hover:prose-a:text-bek-dark prose-a:no-underline prose-a:font-semibold transition-colors
                            prose-p:text-gray-600 prose-p:leading-relaxed prose-p:font-light
                            prose-blockquote:border-l-4 prose-blockquote:border-bek-gold prose-blockquote:bg-gray-50 prose-blockquote:p-4 prose-blockquote:italic prose-blockquote:text-gray-700 prose-blockquote:rounded-r-lg
                            prose-li:text-gray-600 prose-li:font-light marker:text-bek-gold
                            prose-strong:text-bek-dark prose-strong:font-semibold">
                    <slot />
                </div>
                
                <!-- Otomatik Pazarlama/Satış Modülü -->
                <div class="mt-12 pt-8 border-t border-gray-100 text-center bg-gray-50 -mx-6 md:-mx-10 -mb-6 md:-mb-10 p-8 md:p-10 rounded-b-2xl">
                    <h3 class="text-xl font-bold text-bek-dark mb-3 tracking-tight">Eğitim Yolculuğunuzda Yanınızdayız</h3>
                    <p class="text-gray-500 mb-6 font-light max-w-lg mx-auto leading-relaxed text-sm">Öğrencinize özel hazırlanan veri destekli VIP koçluk sistemimizle tanışmak için kurumumuza bekleriz.</p>
                    <a href="/#iletisim" class="inline-flex items-center bg-bek-gold text-white px-6 py-3 rounded-full hover:bg-bek-dark hover:scale-105 transition-all duration-300 shadow-sm shadow-bek-gold/20 font-medium text-sm">
                        Bize Ulaşın
                        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                </div>

            </div>
        </article>
    </main>
</Layout>